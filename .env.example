# ====================================================================
# CẤU HÌNH API MÔ HÌNH NGÔN NGỮ (LLM) — MINI HACKATHON AI B04
# Nhóm chỉ cần đổi LLM_PROVIDER và điền API KEY tương ứng bên dưới
# ====================================================================

# 1. Chọn nhà cung cấp mô hình: openrouter | gemini | openai | custom
LLM_PROVIDER=openrouter

# 2. OpenRouter (Mặc định)
# Lấy key tại: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
# Một số model gợi ý trên OpenRouter:
# - meta-llama/llama-3.3-70b-instruct
# - google/gemini-2.0-flash-001
# - mistralai/mistral-large-2411
# - deepseek/deepseek-chat

# 3. Google Gemini (Nếu muốn đổi sang Gemini trực tiếp)
# Lấy key tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# 4. OpenAI (Nếu muốn đổi sang OpenAI trực tiếp)
# Lấy key tại: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# 5. Tùy chọn nâng cao
TEMPERATURE=0.1
MAX_TOKENS=1000

